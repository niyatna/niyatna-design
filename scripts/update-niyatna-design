#!/usr/bin/env bash
# ==============================================================================
# update-niyatna-design — Native installer & updater for Niyatna Design (.deb)
# ==============================================================================
set -euo pipefail

INSTALL_DIR="$HOME/.local/opt/niyatna-design"
BIN_DIR="$HOME/.local/bin"
DESKTOP_DIR="$HOME/.local/share/applications"
ICONS_DIR="$HOME/.local/share/icons"
TMP_DIR="/tmp/niyatna_design_update_$$"
REPO="niyatna/niyatna-design"

trap 'rm -rf "$TMP_DIR"' EXIT INT TERM
mkdir -p "$BIN_DIR" "$DESKTOP_DIR" "$ICONS_DIR" "$TMP_DIR"

BOLD='\033[1m'
GREEN='\033[0;32m'
CYAN='\033[0;36m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m'

log_info() { echo -e "${CYAN}${BOLD}==>${NC} ${BOLD}$*${NC}"; }
log_success() { echo -e "${GREEN}${BOLD}==>${NC} ${GREEN}$*${NC}"; }
log_warn() { echo -e "${YELLOW}${BOLD}==>${NC} ${YELLOW}$*${NC}"; }
log_err() { echo -e "${RED}${BOLD}==>${NC} ${RED}$*${NC}" >&2; }

if [ "${1:-}" = "--build" ] || [ "${1:-}" = "--build-release" ]; then
    log_info "Triggering GitHub Actions Desktop build on ${REPO}..."
    gh workflow run build-desktop.yml --repo "$REPO" -f release_tag="v0.21.1"
    log_info "Waiting for GitHub Actions runner..."
    sleep 4
    RUN_ID=$(gh run list --workflow=build-desktop.yml --repo "$REPO" --limit 1 --json databaseId -q '.[0].databaseId')
    if [ -n "$RUN_ID" ]; then
        gh run watch "$RUN_ID" --repo "$REPO" || true
    fi
fi

log_info "Checking latest Niyatna Design release from ${REPO}..."
RELEASE_JSON=$(gh api "repos/$REPO/releases/latest" 2>/dev/null || curl -sf "https://api.github.com/repos/$REPO/releases/latest" || true)

if [ -z "$RELEASE_JSON" ] || [ "$RELEASE_JSON" = "null" ]; then
    log_warn "No releases found in ${REPO} yet!"
    log_info "You can trigger a build right now with:"
    echo "   update-niyatna-design --build"
    exit 1
fi

LATEST_TAG=$(echo "$RELEASE_JSON" | jq -r '.tag_name // empty')
VERSION="${LATEST_TAG#v}"

DEB_URL=$(echo "$RELEASE_JSON" | jq -r '.assets[]? | select(.name | test(".*\\.deb$")) | .browser_download_url' | head -n 1)
APPIMAGE_URL=$(echo "$RELEASE_JSON" | jq -r '.assets[]? | select(.name | test(".*\\.AppImage$")) | .browser_download_url' | head -n 1)

CURRENT_VER=""
if [ -f "$INSTALL_DIR/version.txt" ]; then
    CURRENT_VER=$(cat "$INSTALL_DIR/version.txt")
fi

log_info "Latest version: $VERSION (Current: ${CURRENT_VER:-none})"

if [ "$CURRENT_VER" = "$VERSION" ] && [ "${1:-}" != "--force" ] && [ "${1:-}" != "--build" ]; then
    log_success "Niyatna Design is already up to date (version $VERSION)!"
    exit 0
fi

if [ -n "$DEB_URL" ]; then
    DEB_FILE="$TMP_DIR/niyatna-design_${VERSION}.deb"
    log_info "Downloading Niyatna Design ${VERSION} (.deb package)..."
    if command -v aria2c >/dev/null 2>&1; then
        aria2c -x 16 -s 16 -k 1M -d "$TMP_DIR" -o "niyatna-design_${VERSION}.deb" "$DEB_URL" --allow-overwrite=true
    else
        curl -fL "$DEB_URL" -o "$DEB_FILE"
    fi

    log_info "Extracting package into user space..."
    UNPACK_DIR="$TMP_DIR/unpack"
    mkdir -p "$UNPACK_DIR"
    bsdtar -xf "$DEB_FILE" -C "$UNPACK_DIR"

    DATA_TAR=$(find "$UNPACK_DIR" -name "data.tar.*" | head -n 1)
    if [ -z "$DATA_TAR" ]; then
        log_err "Could not find data.tar in deb package!"
        exit 1
    fi

    DATA_UNPACK="$TMP_DIR/data"
    mkdir -p "$DATA_UNPACK"
    bsdtar -xf "$DATA_TAR" -C "$DATA_UNPACK"

    log_info "Installing to $INSTALL_DIR..."
    rm -rf "$INSTALL_DIR"
    mkdir -p "$INSTALL_DIR"

    OPT_DIR=$(find "$DATA_UNPACK/opt" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | head -n 1)
    if [ -n "$OPT_DIR" ]; then
        cp -r "$OPT_DIR/"* "$INSTALL_DIR/"
    elif [ -d "$DATA_UNPACK/usr/lib" ]; then
        LIB_DIR=$(find "$DATA_UNPACK/usr/lib" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | head -n 1)
        if [ -n "$LIB_DIR" ]; then
            cp -r "$LIB_DIR/"* "$INSTALL_DIR/"
        fi
    fi

    echo "$VERSION" > "$INSTALL_DIR/version.txt"

    TARGET_EXEC=$(find "$INSTALL_DIR" -maxdepth 1 \( -name "niyatna-design" -o -name "Niyatna Design" -o -name "Open Design" -o -name "open-design" \) -executable -type f | head -n 1)
    if [ -z "$TARGET_EXEC" ]; then
        TARGET_EXEC=$(find "$INSTALL_DIR" -maxdepth 1 -executable -type f | head -n 1)
    fi

    if [ -n "$TARGET_EXEC" ]; then
        ln -sfn "$TARGET_EXEC" "$BIN_DIR/niyatna-design"
        ln -sfn "$TARGET_EXEC" "$BIN_DIR/open-design"
        log_success "Symlinked $(basename "$TARGET_EXEC") -> $BIN_DIR/niyatna-design"
    fi

    # Icons
    ICON_SRC=$(find "$DATA_UNPACK/usr/share/icons" -name "*.png" 2>/dev/null | sort -V | tail -n 1)
    if [ -z "$ICON_SRC" ]; then
        ICON_SRC=$(find "$DATA_UNPACK" -name "*icon*.png" 2>/dev/null | sort -V | tail -n 1)
    fi
    if [ -n "$ICON_SRC" ]; then
        for size in 16 24 32 48 64 128 256 512; do
            mkdir -p "$ICONS_DIR/hicolor/${size}x${size}/apps"
            cp "$ICON_SRC" "$ICONS_DIR/hicolor/${size}x${size}/apps/niyatna-design.png"
        done
        mkdir -p "$ICONS_DIR"
        cp "$ICON_SRC" "$ICONS_DIR/niyatna-design.png"
        cp "$ICON_SRC" "$INSTALL_DIR/niyatna-design.png" 2>/dev/null || true
        gtk-update-icon-cache -f "$ICONS_DIR/hicolor" 2>/dev/null || true
    fi

    # Desktop Launcher
    cat << DESKTOP_EOF > "$DESKTOP_DIR/niyatna-design.desktop"
[Desktop Entry]
Name=Niyatna Design
Comment=Local-first AI design studio
Exec=$BIN_DIR/niyatna-design %U
Terminal=false
Type=Application
Icon=niyatna-design
Categories=Development;Graphics;Design;
StartupWMClass=niyatna-design
DESKTOP_EOF

    update-desktop-database "$DESKTOP_DIR" 2>/dev/null || true
    log_success "Niyatna Design $VERSION successfully installed!"
elif [ -n "$APPIMAGE_URL" ]; then
    log_info "Downloading AppImage fallback..."
    APPIMAGE_FILE="$HOME/Applications/Niyatna-Design.AppImage"
    curl -fL "$APPIMAGE_URL" -o "$APPIMAGE_FILE"
    chmod +x "$APPIMAGE_FILE"
    ln -sfn "$APPIMAGE_FILE" "$BIN_DIR/niyatna-design"
    log_success "AppImage downloaded to $APPIMAGE_FILE"
fi
