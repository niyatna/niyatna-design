#!/usr/bin/env bash
# ==============================================================================
# update-open-design - Custom Docker Updater & Manager for Niyatna Open Design
# ==============================================================================
set -euo pipefail

# Configuration
SERVICE_DIR="${SERVICE_DIR:-/home/ubuntu/services/open-design/deploy}"
DEFAULT_IMAGE="${DEFAULT_IMAGE:-ghcr.io/niyatna/od:latest}"
PORT="${PORT:-7456}"
BACKUP_FILE="${SERVICE_DIR}/.previous_image"
GITHUB_REPO="niyatna/niyatna-design"

# ANSI Colors
BOLD='\033[1m'
GREEN='\033[0;32m'
CYAN='\033[0;36m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m'

# Helpers
log_info() { echo -e "${CYAN}${BOLD}==>${NC} ${BOLD}$*${NC}"; }
log_success() { echo -e "${GREEN}${BOLD}==>${NC} ${GREEN}$*${NC}"; }
log_warn() { echo -e "${YELLOW}${BOLD}==>${NC} ${YELLOW}$*${NC}"; }
log_err() { echo -e "${RED}${BOLD}==>${NC} ${RED}$*${NC}" >&2; }

show_help() {
  cat << 'HELP'
Usage: update-open-design [options]

Options:
  -u, --update         Pull latest release/latest image from GHCR (Default action)
  -n, --nightly        Fetch and update to the latest commit SHA image from main branch
  -t, --tag <tag>      Update to specific image tag (e.g. sha-01a6ec2 or v0.21.1)
  -r, --restart        Restart the running container without pulling
  -s, --status         Display service status, active image, memory & health
  -l, --logs           Stream live container logs
  -k, --rollback       Rollback to previously running image
  -c, --clean          Prune dangling Docker images and build cache
  -h, --help           Show this help message

Examples:
  update-open-design
  update-open-design --nightly
  update-open-design --status
  update-open-design --tag sha-01a6ec2
  update-open-design --logs
HELP
}

probe_health() {
  curl -sf --max-time 3 "http://100.85.83.76:${PORT}/api/health" 2>/dev/null || \
  curl -sf --max-time 3 "http://127.0.0.1:${PORT}/api/health" 2>/dev/null || \
  (cd "${SERVICE_DIR}" && docker compose exec -T open-design node -e "fetch('http://127.0.0.1:7456/api/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))" 2>/dev/null)
}

check_health() {
  local max_retries=30
  local count=0
  log_info "Verifying container health on port ${PORT}..."
  while [ $count -lt $max_retries ]; do
    if probe_health >/dev/null 2>&1; then
      log_success "Open Design is healthy and responding!"
      return 0
    fi
    count=$((count + 1))
    sleep 2
  done
  log_err "Health check timed out after $((max_retries * 2))s."
  return 1
}

do_status() {
  log_info "Open Design Service Status"
  cd "${SERVICE_DIR}"
  docker compose ps
  echo ""
  log_info "Container Resource Usage:"
  docker stats --no-stream open-design 2>/dev/null || true
  echo ""
  log_info "Health Probe:"
  local health_out
  if health_out=$(probe_health); then
    echo -e "${GREEN}✓ Healthy:${NC} ${health_out:-OK}"
  else
    echo -e "${RED}✗ Unhealthy / Offline${NC}"
  fi
}

do_logs() {
  cd "${SERVICE_DIR}"
  docker compose logs -f --tail=100
}

do_clean() {
  log_info "Cleaning dangling Docker images and build cache..."
  docker image prune -f
  docker builder prune -f 2>/dev/null || true
  log_success "Clean complete."
}

do_restart() {
  log_info "Restarting open-design container..."
  cd "${SERVICE_DIR}"
  docker compose restart open-design
  check_health
}

do_rollback() {
  if [ ! -f "${BACKUP_FILE}" ]; then
    log_err "No previous image backup found at ${BACKUP_FILE}."
    exit 1
  fi
  local prev_img
  prev_img=$(cat "${BACKUP_FILE}")
  log_warn "Rolling back to: ${prev_img}"
  cd "${SERVICE_DIR}"
  sed -i "s|^OPEN_DESIGN_IMAGE=.*|OPEN_DESIGN_IMAGE=${prev_img}|" .env
  docker compose up -d --remove-orphans
  check_health
}

do_update() {
  local target_tag="${1:-latest}"
  local image="ghcr.io/niyatna/od:${target_tag}"

  log_info "Target image: ${image}"
  cd "${SERVICE_DIR}"

  # Save current image for rollback
  if grep -q "^OPEN_DESIGN_IMAGE=" .env; then
    grep "^OPEN_DESIGN_IMAGE=" .env | cut -d'=' -f2 > "${BACKUP_FILE}" || true
  fi

  # Update .env
  if grep -q "^OPEN_DESIGN_IMAGE=" .env; then
    sed -i "s|^OPEN_DESIGN_IMAGE=.*|OPEN_DESIGN_IMAGE=${image}|" .env
  else
    echo "OPEN_DESIGN_IMAGE=${image}" >> .env
  fi

  log_info "Pulling image ${image}..."
  docker pull "${image}"

  log_info "Recreating container..."
  docker compose up -d --remove-orphans

  check_health

  log_info "Pruning old images..."
  docker image prune -f >/dev/null 2>&1 || true

  log_success "Open Design successfully updated to ${image}!"
}

do_nightly() {
  log_info "Querying latest commit SHA from GitHub: ${GITHUB_REPO}..."
  local commit_sha
  commit_sha=$(curl -sf -H "Accept: application/vnd.github.v3+json" "https://api.github.com/repos/${GITHUB_REPO}/commits/main" | grep '"sha":' | head -n 1 | cut -d'"' -f4 | cut -c1-7)

  if [ -z "${commit_sha}" ]; then
    log_err "Failed to query latest commit SHA from GitHub API. Falling back to latest tag."
    do_update "latest"
    return
  fi

  local target_tag="sha-${commit_sha}"
  log_info "Found latest commit: ${commit_sha} -> Target tag: ${target_tag}"
  do_update "${target_tag}"
}

# CLI Argument parsing
ACTION="update"
TARGET_TAG="latest"

while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help)
      show_help
      exit 0
      ;;
    -n|--nightly)
      ACTION="nightly"
      shift
      ;;
    -s|--status)
      ACTION="status"
      shift
      ;;
    -l|--logs)
      ACTION="logs"
      shift
      ;;
    -r|--restart)
      ACTION="restart"
      shift
      ;;
    -k|--rollback)
      ACTION="rollback"
      shift
      ;;
    -c|--clean)
      ACTION="clean"
      shift
      ;;
    -u|--update)
      ACTION="update"
      shift
      ;;
    -t|--tag)
      ACTION="update"
      TARGET_TAG="$2"
      shift 2
      ;;
    *)
      log_err "Unknown option: $1"
      show_help
      exit 1
      ;;
  esac
done

case "${ACTION}" in
  status)   do_status ;;
  logs)     do_logs ;;
  restart)  do_restart ;;
  rollback) do_rollback ;;
  clean)    do_clean ;;
  update)   do_update "${TARGET_TAG}" ;;
  nightly)  do_nightly ;;
esac
